<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F8F2">

    <!-- Top Right Reject Button -->
    <ImageButton
        android:id="@+id/btnReject"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#111827"
        android:elevation="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomContainer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Background Glowing Circle setup for the Bell -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_light_green_circle"
                    android:alpha="0.4" />
                
                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_light_green_circle"
                    android:alpha="0.7" />

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    android:background="@drawable/bg_green_circle"
                    android:padding="20dp"
                    android:elevation="4dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Delivery!"
                android:textColor="#111827"
                android:textSize="32sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review order details below"
                android:textColor="#6B7280"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="32dp" />

            <!-- White Card for details -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_white_card"
                android:elevation="8dp">

                <!-- Abstract green blob on top right -->
                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_light_green_circle"
                    android:layout_marginTop="-40dp"
                    android:layout_marginEnd="-40dp"
                    android:alpha="0.6"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Pickup From -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="32dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_store"
                            android:background="@drawable/rounded_white_card"
                            android:elevation="2dp"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PICKUP FROM"
                                android:textColor="#9CA3AF"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:textAllCaps="true" />
                                
                            <TextView
                                android:id="@+id/tvPickupStall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cafe"
                                android:textColor="#111827"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-black" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Distances Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="24dp"
                        android:weightSum="2">
                        
                        <!-- Pickup -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/rounded_white_card"
                            android:backgroundTint="#F9FAFB"
                            android:padding="16dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PICKUP"
                                    android:textColor="#9CA3AF"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif-black" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tvPickupDistance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="1.3 km"
                                android:textColor="#111827"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-black"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        
                        <!-- Drop-off -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/rounded_white_card"
                            android:backgroundTint="#F9FAFB"
                            android:padding="16dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DROP-OFF"
                                    android:textColor="#9CA3AF"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif-black" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tvDropoffDistance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="1.2 km"
                                android:textColor="#111827"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-black"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F3F4F6"
                        android:layout_marginBottom="24dp" />

                    <!-- Delivery Pay -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DELIVERY PAY"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-black"
                            android:layout_centerVertical="true" />
                        <TextView
                            android:id="@+id/tvDeliveryPay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹15.0"
                            android:textColor="#4B5563"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-black"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>
                    
                    <RelativeLayout
                        android:id="@+id/rlPickupPay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PICKUP PAY"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-black"
                            android:layout_centerVertical="true" />
                        <TextView
                            android:id="@+id/tvPickupPay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.0"
                            android:textColor="#4B5563"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-black"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>
                    
                    <RelativeLayout
                        android:id="@+id/rlReturnPay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RETURN PAY"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-black"
                            android:layout_centerVertical="true" />
                        <TextView
                            android:id="@+id/tvReturnPay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.0"
                            android:textColor="#4B5563"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-black"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <!-- Total Payout -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL PAYOUT"
                            android:textColor="#9CA3AF"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-black"
                            android:layout_centerVertical="true" />
                        <TextView
                            android:id="@+id/tvTotalPayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹15.0"
                            android:textColor="#10B981"
                            android:textSize="32sp"
                            android:fontFamily="sans-serif-black"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <!-- Invisible views to prevent crash if java code looks for them -->
                    <TextView android:id="@+id/tvItems" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvCustomerName" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvCustomerAddress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

                </LinearLayout>
            </FrameLayout>
            
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons Container -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="24dp"
        android:background="@android:color/transparent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/rounded_white_card"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="SLIDE TO ACCEPT"
                android:textColor="#9CA3AF"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sbAccept"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:progressDrawable="@android:color/transparent"
                android:splitTrack="false"
                android:thumb="@drawable/slider_thumb_green"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:max="100"
                android:progress="0" />
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>
